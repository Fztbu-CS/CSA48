---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Podium from '../components/Podium.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Timeline from '../components/Timeline.astro';
import PersonDetailModal from '../components/PersonDetailModal.astro';
import Icon from '../components/Icon.astro';

import { getInitialData, computePersonStats } from '../utils/dataHelper';

const { persons, incidents } = getInitialData();
const { rankedPersons, totalIncidents } = computePersonStats(persons, incidents);
const top3 = rankedPersons.slice(0, 3);
---

<Layout>
  <Navbar />

  <main class="mx-auto max-w-7xl w-full flex-1 px-4 py-6 sm:px-6 lg:px-8 space-y-8">
    <!-- Podium -->
    <Podium top3={top3} />

    <!-- View Container -->
    <div class="relative pt-2">
      <!-- View 1: Leaderboard (猪排行) -->
      <section id="view-leaderboard" class="transition-opacity duration-200">
        <div class="mb-4 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-md-secondary-container text-md-on-secondary-container">
              <Icon name="trophy" class="h-4 w-4" />
            </div>
            <h2 class="text-lg font-bold tracking-tight text-md-on-surface sm:text-xl">猪排行</h2>
            <span class="rounded-md-full border border-md-outline-variant/30 bg-md-surface-container-high px-2.5 py-0.5 text-xs font-medium text-md-on-surface-variant">
              共 {rankedPersons.length} 只猪猪
            </span>
          </div>
        </div>
        <Leaderboard rankedPersons={rankedPersons} />
      </section>

      <!-- View 2: Timeline (猪记录) -->
      <section id="view-timeline" class="hidden transition-opacity duration-200">
        <div class="mb-4 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-md-secondary-container text-md-on-secondary-container">
              <Icon name="timeline" class="h-4 w-4" />
            </div>
            <h2 class="text-lg font-bold tracking-tight text-md-on-surface sm:text-xl">猪记录</h2>
            <span class="rounded-md-full border border-md-outline-variant/30 bg-md-surface-container-high px-2.5 py-0.5 text-xs font-medium text-md-on-surface-variant">
              共 {totalIncidents} 起案件
            </span>
          </div>
        </div>
        <Timeline incidents={incidents} persons={persons} />
      </section>
    </div>
  </main>

  <!-- Person Detail Modal -->
  <PersonDetailModal persons={rankedPersons} />
</Layout>