---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Podium from '../components/Podium.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Timeline from '../components/Timeline.astro';
import PersonDetailModal from '../components/PersonDetailModal.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';

import { getInitialData, computePersonStats } from '../utils/dataHelper';

const { persons, incidents } = getInitialData();
const { rankedPersons, totalIncidents } = computePersonStats(persons, incidents);
const top3 = rankedPersons.slice(0, 3);
---

<Layout>
  <Navbar />

  <main class="mx-auto max-w-7xl w-full flex-1 px-4 py-6 sm:px-6 lg:px-8 space-y-8">
    <!-- Podium -->
    <Podium top3={top3} />

    <!-- View Container -->
    <div class="relative pt-2">
      <!-- View 1: Leaderboard (猪排行) -->
      <section id="view-leaderboard" class="transition-opacity duration-200">
        <SectionHeader
          icon="trophy"
          title="猪排行"
          countLabel={`共 ${rankedPersons.length} 只猪猪`}
        />
        <Leaderboard rankedPersons={rankedPersons} />
      </section>

      <!-- View 2: Timeline (猪记录) -->
      <section id="view-timeline" class="hidden transition-opacity duration-200">
        <SectionHeader
          icon="timeline"
          title="猪记录"
          countLabel={`共 ${totalIncidents} 起案件`}
        />
        <Timeline incidents={incidents} persons={persons} />
      </section>
    </div>
  </main>

  <!-- Person Detail Modal -->
  <PersonDetailModal persons={rankedPersons} />
</Layout>