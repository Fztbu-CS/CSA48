---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "!?猪猪?! · !?者者?!",
  description = "!?者者?! - 记录每一次犯蠢瞬间，全自动次数排行。",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/pig.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Theme Initializer Script (Prevents FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      document.documentElement.setAttribute('data-theme', theme);
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content antialiased">
    <slot />

    <!-- Footer -->
    <footer class="footer footer-center mt-auto border-t border-base-300 px-4 py-8 text-base-content/70">
      <nav class="flex items-center justify-center gap-4 text-xs font-medium">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="link link-hover">
          GitHub Repository
        </a>
      </nav>
    </footer>
  </body>
</html>