---
import type { ShameIncident, Person } from '../data/types';
import Icon from './Icon.astro';
import { resolveAvatar } from '../utils/avatar';

interface Props {
  incidents: ShameIncident[];
  persons: Person[];
}

const { incidents, persons } = Astro.props;

// 按日期倒序
const sortedIncidents = [...incidents].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const personMap = new Map(persons.map((p) => [p.id, p]));
---

<div class="space-y-6">
  <!-- 搜索 -->
  <div class="card card-bordered bg-base-200 shadow-sm">
    <div class="card-body p-3 gap-3 sm:flex-row sm:items-center sm:justify-between">
      <label class="input input-bordered flex w-full items-center gap-2 bg-base-100 sm:w-80">
        <Icon name="search" class="w-4 h-4 opacity-60" />
        <input id="timeline-search" type="text" class="grow" placeholder="搜索历史事件、猪猪..." />
      </label>
      <div class="hidden text-xs text-base-content/60 pr-2 sm:block">
        共记录 {sortedIncidents.length} 起翻车历史
      </div>
    </div>
  </div>

  <!-- 时间线 -->
  {sortedIncidents.length === 0 ? (
    <div class="card card-bordered bg-base-200 shadow-sm">
      <div class="card-body items-center py-12 text-center">
        <Icon name="timeline" class="w-8 h-8 text-base-content/30" />
        <p class="text-sm font-semibold">暂无翻车历史记录</p>
        <p class="text-xs text-base-content/60">目前暂无任何案件发生，岁月静好~</p>
      </div>
    </div>
  ) : (
    <ul id="timeline-list" class="timeline timeline-vertical">
      {sortedIncidents.map((incident, index) => {
        const person = personMap.get(incident.personId);
        const avatar = person ? resolveAvatar(person.avatar, person.name) : null;
        const isLast = index === sortedIncidents.length - 1;

        return (
          <li>
            <div class="timeline-start">
              <span class="badge badge-ghost gap-1.5 font-mono">
                <Icon name="calendar" class="w-3.5 h-3.5" />
                <span>{incident.date}</span>
              </span>
            </div>

            <div class="timeline-middle">
              <Icon name="timeline" class="w-4 h-4 text-primary" />
            </div>

            <div
              class="timeline-end timeline-box timeline-card w-full p-4 sm:p-5"
              data-title={incident.title}
              data-description={incident.description}
              data-person={person?.name || ''}
            >
              <!-- 猪猪信息 -->
              {person && (
                <div class="mb-3 flex items-center gap-2.5">
                  <div class="avatar placeholder shrink-0">
                    <div class="w-8 rounded-lg bg-neutral text-neutral-content text-xs font-bold">
                      {avatar?.src ? (
                        <img
                          src={avatar.src}
                          alt={person.name}
                          onerror={`this.parentElement.textContent='${avatar.fallback}'`}
                        />
                      ) : (
                        <span>{avatar?.fallback}</span>
                      )}
                    </div>
                  </div>
                  <span class="text-sm font-bold">{person.name}</span>
                </div>
              )}

              <h3 class="mb-2 text-base font-bold leading-snug sm:text-lg">{incident.title}</h3>

              <p class="rounded-box border border-base-300 bg-base-200/60 p-3.5 text-sm leading-relaxed">
                {incident.description}
              </p>
            </div>

            {!isLast && <hr class="bg-primary/40" />}
          </li>
        );
      })}
    </ul>
  )}
</div>

<script>
  // 时间线搜索过滤
  const searchInput = document.getElementById('timeline-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.timeline-card');

  searchInput?.addEventListener('input', () => {
    const query = (searchInput.value || '').toLowerCase().trim();

    cards.forEach((card) => {
      const title = (card.getAttribute('data-title') || '').toLowerCase();
      const desc = (card.getAttribute('data-description') || '').toLowerCase();
      const person = (card.getAttribute('data-person') || '').toLowerCase();

      const matched = !query || title.includes(query) || desc.includes(query) || person.includes(query);
      card.classList.toggle('hidden', !matched);
      (card.parentElement as HTMLElement | null)?.classList.toggle('hidden', !matched);
    });
  });
</script>