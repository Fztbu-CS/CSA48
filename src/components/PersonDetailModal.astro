---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import { resolveAvatar } from '../utils/avatar';

interface Props {
  persons: PersonStats[];
}

const { persons } = Astro.props;

// Pre-resolve avatar and incident data for client-side script
const personsView = persons.map((p) => {
  const avatar = resolveAvatar(p.avatar, p.name);
  return {
    id: p.id,
    name: p.name,
    rank: p.rank ?? 0,
    totalCount: p.totalCount,
    avatarSrc: avatar.src,
    avatarFallback: avatar.fallback,
    incidents: p.incidents.map((inc) => ({
      date: inc.date,
      title: inc.title,
      description: inc.description,
    })),
  };
});
---

<dialog id="person-detail-dialog" class="backdrop:bg-black/50 p-4">
  <div class="mx-auto flex max-h-[85vh] w-full max-w-2xl flex-col overflow-hidden rounded-md-3xl border border-md-outline-variant/30 dark:border-transparent bg-md-surface-container-high p-6 shadow-md-3 sm:p-8">
    <!-- Header -->
    <div class="flex shrink-0 items-start justify-between gap-4 border-b border-md-outline-variant/20 dark:border-white/5 pb-4">
      <div class="flex items-center gap-4">
        <div
          id="modal-person-avatar"
          class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-md-primary-container text-2xl font-black text-md-on-primary-container shadow-sm"
        >
          <span>?</span>
        </div>

        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2.5">
            <h2 id="modal-person-name" class="text-xl font-bold text-md-on-surface sm:text-2xl">猪猪姓名</h2>
            <span id="modal-person-rank" class="rounded-md-full bg-md-secondary-container px-3 py-0.5 text-xs font-bold text-md-on-secondary-container shadow-xs">
              #1
            </span>
          </div>
          <span class="text-xs text-md-on-surface-variant">个人犯蠢卷宗全收录</span>
        </div>
      </div>

      <form method="dialog">
        <button
          class="md-state-layer flex h-9 w-9 items-center justify-center rounded-full text-md-on-surface-variant transition-colors hover:bg-md-on-surface/8 hover:text-md-on-surface"
          aria-label="关闭"
        >
          <Icon name="close" class="h-4 w-4" />
        </button>
      </form>
    </div>

    <!-- Metric Banner -->
    <div class="my-4 flex shrink-0 items-center justify-between rounded-md-2xl border border-md-primary/20 dark:border-transparent bg-md-primary-container/30 px-5 py-3.5">
      <div>
        <div class="text-xs font-semibold text-md-primary">累计作案次数</div>
        <div class="mt-0.5 text-[11px] text-md-on-surface-variant">卷宗经众人核实录入登记</div>
      </div>
      <div id="modal-person-count" class="text-2xl font-black text-md-primary">0 次</div>
    </div>

    <!-- Incidents Scroll Area -->
    <div class="flex-1 overflow-y-auto pr-1">
      <div class="mb-3 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-md-on-surface-variant">
        <Icon name="file-text" class="h-3.5 w-3.5" />
        <span>完整翻车档案记录</span>
      </div>

      <div id="modal-incidents-container" class="space-y-3">
        <!-- Rendered by client script -->
      </div>
    </div>

    <!-- Footer Action -->
    <div class="mt-4 flex justify-end shrink-0 border-t border-md-outline-variant/20 dark:border-white/5 pt-4">
      <form method="dialog">
        <button class="md-state-layer rounded-md-full bg-md-secondary-container px-6 py-2 text-xs font-semibold text-md-on-secondary-container hover:shadow-md-1 transition-all">
          关闭档案
        </button>
      </form>
    </div>
  </div>
</dialog>

<script define:vars={{ personsData: personsView }}>
  const personModal = document.getElementById('person-detail-dialog');
  const avatarEl = document.getElementById('modal-person-avatar');
  const nameEl = document.getElementById('modal-person-name');
  const rankEl = document.getElementById('modal-person-rank');
  const countEl = document.getElementById('modal-person-count');
  const incidentsContainer = document.getElementById('modal-incidents-container');

  // Click outside backdrop to close
  personModal?.addEventListener('click', (e) => {
    if (e.target === personModal) {
      personModal.close();
    }
  });

  // Global listener for "查看卷宗" buttons
  document.addEventListener('click', (e) => {
    const target = e.target.closest('.view-person-btn');
    if (!target) return;

    const personId = target.getAttribute('data-person-id');
    const person = personsData.find((p) => p.id === personId);
    if (!person || !personModal) return;

    // Header info
    if (avatarEl) {
      avatarEl.innerHTML = person.avatarSrc
        ? `<img src="${person.avatarSrc}" alt="${person.name}" class="h-full w-full object-cover" onerror="this.parentElement.textContent='${person.avatarFallback}'" />`
        : `<span>${person.avatarFallback}</span>`;
    }
    if (nameEl) nameEl.textContent = person.name;
    if (rankEl) rankEl.textContent = `#${person.rank || 'N/A'}`;
    if (countEl) countEl.textContent = `${person.totalCount} 次`;

    // Incidents
    if (incidentsContainer) {
      if (!person.incidents || person.incidents.length === 0) {
        incidentsContainer.innerHTML =
          '<div class="py-8 text-center text-xs text-md-on-surface-variant">暂无翻车案底</div>';
      } else {
        incidentsContainer.innerHTML = person.incidents
          .map(
            (inc) => `
          <div class="rounded-md-2xl border border-md-outline-variant/20 dark:border-transparent bg-md-surface-container p-4 space-y-2">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 rounded-md-full border border-md-outline-variant/20 dark:border-transparent bg-md-surface-container-high px-2.5 py-0.5 font-mono text-[11px] text-md-on-surface-variant">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
                <span>${inc.date}</span>
              </span>
            </div>
            <h4 class="text-sm font-bold text-md-on-surface">${inc.title}</h4>
            <p class="rounded-md-xl border border-md-outline-variant/20 dark:border-transparent bg-md-surface-container-low p-3 text-xs leading-relaxed text-md-on-surface-variant">
              ${inc.description}
            </p>
          </div>
        `
          )
          .join('');
      }
    }

    personModal.showModal();
  });
</script>