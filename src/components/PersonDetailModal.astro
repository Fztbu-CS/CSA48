---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import { resolveAvatar } from '../utils/avatar';

interface Props {
  persons: PersonStats[];
}

const { persons } = Astro.props;

// 预解析头像与卷宗数据，供客户端脚本直接渲染
const personsView = persons.map((p) => {
  const avatar = resolveAvatar(p.avatar, p.name);
  return {
    id: p.id,
    name: p.name,
    rank: p.rank ?? 0,
    totalCount: p.totalCount,
    avatarSrc: avatar.src,
    avatarFallback: avatar.fallback,
    incidents: p.incidents.map((inc) => ({
      date: inc.date,
      title: inc.title,
      description: inc.description,
    })),
  };
});
---

<dialog id="person-detail-dialog" class="modal">
  <div class="modal-box max-w-2xl flex max-h-[85vh] flex-col overflow-hidden">
    <!-- 头部 -->
    <div class="flex shrink-0 items-start justify-between gap-4 border-b border-base-300 pb-4">
      <div class="flex items-center gap-4">
        <div class="avatar placeholder shrink-0">
          <div
            id="modal-person-avatar"
            class="w-16 rounded-xl bg-neutral text-neutral-content text-2xl font-black"
          >
            <span>?</span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <h2 id="modal-person-name" class="text-xl font-bold sm:text-2xl">猪猪姓名</h2>
          <span id="modal-person-rank" class="badge badge-secondary font-bold">#1</span>
        </div>
      </div>

      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost" aria-label="关闭">
          <Icon name="close" class="w-4 h-4" />
        </button>
      </form>
    </div>

    <!-- 统计条 -->
    <div class="my-4 flex shrink-0 items-center justify-between rounded-box border border-base-300 bg-base-200 px-6 py-3.5">
      <div>
        <div class="text-xs font-medium">累计</div>
        <div class="mt-0.5 text-[11px] text-base-content/60">档案卷宗经大伙核实登记</div>
      </div>
      <div id="modal-person-count" class="text-2xl font-black text-primary">0 次</div>
    </div>

    <!-- 卷宗列表 -->
    <div class="flex-1 overflow-y-auto pr-1">
      <div class="mb-2 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-base-content/60">
        <Icon name="file-text" class="w-3.5 h-3.5" />
        <span>完整作案卷宗列表</span>
      </div>

      <div id="modal-incidents-container" class="space-y-3"></div>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>关闭</button>
  </form>
</dialog>

<script define:vars={{ personsData: personsView }}>
  const personModal = document.getElementById('person-detail-dialog');
  const avatarEl = document.getElementById('modal-person-avatar');
  const nameEl = document.getElementById('modal-person-name');
  const rankEl = document.getElementById('modal-person-rank');
  const countEl = document.getElementById('modal-person-count');
  const incidentsContainer = document.getElementById('modal-incidents-container');

  // 全局监听「查看卷宗」按钮
  document.addEventListener('click', (e) => {
    const target = e.target.closest('.view-person-btn');
    if (!target) return;

    const personId = target.getAttribute('data-person-id');
    const person = personsData.find((p) => p.id === personId);
    if (!person || !personModal) return;

    // 头部信息
    if (avatarEl) {
      avatarEl.innerHTML = person.avatarSrc
        ? `<img src="${person.avatarSrc}" alt="${person.name}" class="h-full w-full object-cover" onerror="this.parentElement.textContent='${person.avatarFallback}'" />`
        : `<span>${person.avatarFallback}</span>`;
    }
    if (nameEl) nameEl.textContent = person.name;
    if (rankEl) rankEl.textContent = `#${person.rank || 'N/A'}`;
    if (countEl) countEl.textContent = `${person.totalCount} 次`;

    // 卷宗列表
    if (incidentsContainer) {
      if (!person.incidents || person.incidents.length === 0) {
        incidentsContainer.innerHTML =
          '<div class="py-8 text-center text-xs text-base-content/60">暂无翻车案底</div>';
      } else {
        incidentsContainer.innerHTML = person.incidents
          .map(
            (inc) => `
          <div class="card card-bordered bg-base-200">
            <div class="card-body gap-2 p-4">
              <span class="badge badge-ghost gap-1.5 font-mono">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
                <span>${inc.date}</span>
              </span>
              <h4 class="text-sm font-bold">${inc.title}</h4>
              <p class="rounded-box border border-base-300 bg-base-100 p-2.5 text-xs leading-relaxed">
                ${inc.description}
              </p>
            </div>
          </div>
        `
          )
          .join('');
      }
    }

    personModal.showModal();
  });
</script>