---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import { resolveAvatar } from '../utils/avatar';

interface Props {
  rankedPersons: PersonStats[];
}

const { rankedPersons } = Astro.props;

function rankBadgeClass(rank?: number): string {
  if (rank === 1) return 'badge-warning font-black';
  if (rank === 2) return 'badge-neutral font-bold';
  if (rank === 3) return 'badge-accent font-bold';
  return 'badge-ghost font-medium';
}
---

<div class="space-y-4">
  <!-- 搜索与排序 -->
  <div class="card card-bordered bg-base-200 shadow-sm">
    <div class="card-body p-3 gap-3 sm:flex-row sm:items-center sm:justify-between">
      <label class="input input-bordered flex w-full items-center gap-2 bg-base-100 sm:w-80">
        <Icon name="search" class="w-4 h-4 opacity-60" />
        <input id="leaderboard-search" type="text" class="grow" placeholder="搜索猪猪姓名、外号、事迹..." />
      </label>

      <div class="flex w-full items-center justify-end gap-2 sm:w-auto">
        <span class="hidden text-xs text-base-content/60 sm:inline">排序方式：</span>
        <select id="leaderboard-sort" class="select select-bordered select-sm w-full bg-base-100 sm:w-auto">
          <option value="count-desc" selected>按犯蠢次数排序 (由多到少)</option>
          <option value="recent-desc">按作案时间排序 (由近到远)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- 榜单 -->
  <div id="leaderboard-items" class="space-y-3">
    {rankedPersons.length === 0 ? (
      <div class="card card-bordered bg-base-200 shadow-sm">
        <div class="card-body items-center py-12 text-center">
          <Icon name="medal" class="w-8 h-8 text-base-content/30" />
          <p class="text-sm font-semibold">暂无猪猪记录</p>
          <p class="text-xs text-base-content/60">请前往管理后台录入人员与翻车事件</p>
        </div>
      </div>
    ) : (
      rankedPersons.map((person) => {
        const avatar = resolveAvatar(person.avatar, person.name);
        const isFirst = person.rank === 1;

        return (
          <div
            class={`person-card card card-bordered transition-colors ${
              isFirst ? 'border-warning bg-base-100 shadow-md' : 'bg-base-200 hover:bg-base-300/60'
            }`}
            data-name={person.name}
            data-nickname={person.nickname}
            data-count={person.totalCount}
            data-recent={person.recentDate}
            data-id={person.id}
          >
            <div class="card-body p-4 sm:p-5 gap-3">
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <!-- 排名 / 头像 / 姓名 -->
                <div class="flex items-center gap-3.5 min-w-0">
                  <span class={`badge badge-lg shrink-0 font-mono ${rankBadgeClass(person.rank)}`}>
                    #{person.rank}
                  </span>

                  <div class="avatar placeholder shrink-0">
                    <div class="w-12 rounded-xl bg-neutral text-neutral-content text-base font-bold">
                      {avatar.src ? (
                        <img
                          src={avatar.src}
                          alt={person.name}
                          onerror={`this.parentElement.textContent='${avatar.fallback}'`}
                        />
                      ) : (
                        <span>{avatar.fallback}</span>
                      )}
                    </div>
                  </div>

                  <h3 class="font-bold text-base truncate">{person.name}</h3>
                </div>

                <!-- 次数与操作 -->
                <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-4 sm:gap-6 border-t sm:border-t-0 border-base-300 pt-3 sm:pt-0 shrink-0">
                  <span class="badge badge-outline gap-1.5">
                    <span class="text-base-content/60">累计</span>
                    <span class="font-bold text-primary">{person.totalCount} 次</span>
                  </span>

                  <button class="view-person-btn btn btn-sm gap-1.5" data-person-id={person.id}>
                    <Icon name="file-text" class="w-3.5 h-3.5" />
                    <span>案底卷宗</span>
                  </button>
                </div>
              </div>

              <!-- 最新案情 -->
              {person.incidents[0] && (
                <div class="flex items-center justify-between gap-2 border-t border-base-300 pt-3 text-xs text-base-content/60">
                  <div class="flex items-center gap-2 truncate pr-2">
                    <span>最新案情:</span>
                    <span class="font-medium text-base-content truncate">{person.incidents[0].title}</span>
                  </div>
                  <span class="flex items-center gap-1 text-[11px] shrink-0">
                    <Icon name="calendar" class="w-3 h-3" />
                    <span>{person.incidents[0].date}</span>
                  </span>
                </div>
              )}
            </div>
          </div>
        );
      })
    )}
  </div>
</div>

<script>
  // 搜索与排序
  const searchInput = document.getElementById('leaderboard-search') as HTMLInputElement | null;
  const sortSelect = document.getElementById('leaderboard-sort') as HTMLSelectElement | null;
  const container = document.getElementById('leaderboard-items');

  function filterAndSort() {
    if (!container) return;
    const query = (searchInput?.value || '').toLowerCase().trim();
    const sortType = sortSelect?.value || 'count-desc';

    const cards = Array.from(container.querySelectorAll<HTMLElement>('.person-card'));

    // 过滤
    cards.forEach((card) => {
      const name = (card.getAttribute('data-name') || '').toLowerCase();
      const nickname = (card.getAttribute('data-nickname') || '').toLowerCase();
      const matches = name.includes(query) || nickname.includes(query);
      card.classList.toggle('hidden', !matches);
    });

    // 排序
    const visibleCards = cards.slice().sort((a, b) => {
      const countA = Number(a.getAttribute('data-count') || 0);
      const countB = Number(b.getAttribute('data-count') || 0);
      const dateA = new Date(a.getAttribute('data-recent') || 0).getTime();
      const dateB = new Date(b.getAttribute('data-recent') || 0).getTime();

      if (sortType === 'recent-desc') {
        return dateB - dateA;
      }

      if (countB !== countA) {
        return countB - countA;
      }
      return dateB - dateA;
    });

    visibleCards.forEach((card) => container.appendChild(card));
  }

  searchInput?.addEventListener('input', filterAndSort);
  sortSelect?.addEventListener('change', filterAndSort);
</script>