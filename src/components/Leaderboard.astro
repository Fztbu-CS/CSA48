---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';

interface Props {
  rankedPersons: PersonStats[];
}

const { rankedPersons } = Astro.props;

function getRankBadgeStyles(rank?: number) {
  if (rank === 1) return 'bg-md-secondary text-md-on-secondary font-black';
  if (rank === 2) return 'bg-slate-500 text-white font-bold';
  if (rank === 3) return 'bg-amber-800 text-amber-100 font-bold';
  return 'bg-md-surface-container-highest text-md-on-surface-variant font-medium';
}
---

<div class="space-y-4">
  <!-- MD3 Search & Filter Bar -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-md-surface-container-low p-3 rounded-md-2xl border border-md-outline-variant/30 shadow-md-1">
    <!-- MD3 Search Bar -->
    <div class="relative w-full sm:w-80">
      <input
        type="text"
        id="leaderboard-search"
        placeholder="搜索猪猪姓名、外号、事迹..."
        class="w-full h-11 bg-md-surface-container-high border border-transparent rounded-md-full px-4 pl-10 text-xs sm:text-sm text-md-on-surface placeholder-md-on-surface-variant/70 focus:outline-none focus:border-md-primary/60 focus:bg-md-surface-container-highest transition-all"
      />
      <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-md-on-surface-variant">
        <Icon name="search" class="w-4 h-4" />
      </div>
    </div>

    <!-- MD3 Sort Select -->
    <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
      <span class="text-xs text-md-on-surface-variant hidden sm:inline">排序方式：</span>
      <select
        id="leaderboard-sort"
        class="h-11 bg-md-surface-container-high border border-transparent rounded-md-full px-4 text-xs font-medium text-md-on-surface focus:outline-none focus:border-md-primary/60"
      >
        <option value="count-desc" selected>按犯蠢次数排序 (由多到少)</option>
        <option value="recent-desc">按作案时间排序 (由近到远)</option>
      </select>
    </div>
  </div>

  <!-- MD3 Leaderboard Card List -->
  <div id="leaderboard-items" class="space-y-3">
    {rankedPersons.length === 0 ? (
      <div class="text-center py-12 px-4 bg-md-surface-container-low rounded-md-2xl border border-md-outline-variant/30 shadow-sm">
        <div class="w-12 h-12 mx-auto mb-2.5 rounded-full bg-md-surface-container-highest flex items-center justify-center text-md-on-surface-variant/40">
          <Icon name="medal" class="w-6 h-6" />
        </div>
        <p class="text-sm font-semibold text-md-on-surface">暂无猪猪记录</p>
        <p class="text-xs text-md-on-surface-variant mt-1">请前往管理后台录入人员与翻车事件</p>
      </div>
    ) : (
      rankedPersons.map((person) => {
        const isFirst = person.rank === 1;
        const rankBadge = getRankBadgeStyles(person.rank);

        return (
          <div
            class={`person-card md-state-layer rounded-md-xl p-4 sm:p-5 transition-all border ${
              isFirst
                ? 'bg-md-surface-container border-md-secondary/40 shadow-md-1'
                : 'bg-md-surface-container-low hover:bg-md-surface-container border-md-outline-variant/30'
            }`}
            data-name={person.name}
            data-nickname={person.nickname}
            data-count={person.totalCount}
            data-recent={person.recentDate}
            data-id={person.id}
          >
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <!-- Left: Rank & Avatar & Info -->
              <div class="flex items-center gap-3.5 min-w-0">
                <!-- Rank Number Badge -->
                <div class={`w-9 h-9 rounded-md-lg flex items-center justify-center text-xs shrink-0 shadow-sm ${rankBadge}`}>
                  #{person.rank}
                </div>

                <!-- Avatar -->
                <Avatar avatar={person.avatar} name={person.name} sizeClass="w-12 h-12 text-base" />

                <!-- Details -->
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="font-bold text-base text-md-on-surface truncate">{person.name}</h3>
                  </div>
                </div>
              </div>

              <!-- Right: Blunder Count & Action Button -->
              <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-4 sm:gap-6 border-t sm:border-t-0 border-md-outline-variant/20 pt-3 sm:pt-0 shrink-0">
                <!-- Blunder Count Tonal Badge -->
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-md-full bg-md-surface-container-highest border border-md-outline-variant/20">
                  <span class="text-xs text-md-on-surface-variant">累计</span>
                  <span class="text-sm sm:text-base font-bold text-md-primary">
                    {person.totalCount} <span class="text-xs font-normal text-md-on-surface-variant">次</span>
                  </span>
                </div>

                <!-- View Details Button -->
                <button
                  class="view-person-btn md-state-layer inline-flex items-center gap-1.5 px-4 py-2 rounded-md-full bg-md-surface-container-highest hover:bg-md-surface-bright text-xs font-semibold text-md-on-surface transition-all active:scale-95 shrink-0"
                  data-person-id={person.id}
                >
                  <Icon name="file-text" class="w-3.5 h-3.5 text-md-on-surface-variant" />
                  <span>案底卷宗</span>
                </button>
              </div>
            </div>

            <!-- Quick Preview of Last Incident if any -->
            {person.incidents[0] && (
              <div class="mt-3 pt-3 border-t border-md-outline-variant/20 flex items-center justify-between text-xs text-md-on-surface-variant">
                <div class="flex items-center gap-2 truncate pr-2">
                  <span class="text-md-on-surface-variant/70">最新案情:</span>
                  <span class="text-md-on-surface font-medium truncate">{person.incidents[0].title}</span>
                </div>
                <div class="flex items-center gap-1 text-md-on-surface-variant/70 text-[11px] shrink-0">
                  <Icon name="calendar" class="w-3 h-3" />
                  <span>{person.incidents[0].date}</span>
                </div>
              </div>
            )}
          </div>
        );
      })
    )}
  </div>
</div>

<script>
  // Search and Sort Filter Controller
  const searchInput = document.getElementById('leaderboard-search') as HTMLInputElement | null;
  const sortSelect = document.getElementById('leaderboard-sort') as HTMLSelectElement | null;
  const container = document.getElementById('leaderboard-items');

  function filterAndSort() {
    if (!container) return;
    const query = (searchInput?.value || '').toLowerCase().trim();
    const sortType = sortSelect?.value || 'count-desc';

    const cards = Array.from(container.querySelectorAll<HTMLElement>('.person-card'));

    // Filter
    cards.forEach((card) => {
      const name = (card.getAttribute('data-name') || '').toLowerCase();
      const nickname = (card.getAttribute('data-nickname') || '').toLowerCase();
      const matches = name.includes(query) || nickname.includes(query);
      if (matches) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });

    // Sort
    const visibleCards = cards.slice().sort((a, b) => {
      const countA = Number(a.getAttribute('data-count') || 0);
      const countB = Number(b.getAttribute('data-count') || 0);
      const dateA = new Date(a.getAttribute('data-recent') || 0).getTime();
      const dateB = new Date(b.getAttribute('data-recent') || 0).getTime();

      if (sortType === 'recent-desc') {
        return dateB - dateA;
      }

      // Default: count-desc
      if (countB !== countA) {
        return countB - countA;
      }
      return dateB - dateA;
    });

    visibleCards.forEach((card) => container.appendChild(card));
  }

  searchInput?.addEventListener('input', filterAndSort);
  sortSelect?.addEventListener('change', filterAndSort);
</script>
