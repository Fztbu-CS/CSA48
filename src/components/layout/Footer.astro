---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="mt-auto border-t border-md-outline-variant/30 dark:border-transparent bg-md-surface-container-low px-4 py-8 text-center text-md-on-surface-variant">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-3 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-2 text-xs">
      <img src={`${baseUrl}/pig.svg`} alt="Piglet" class="h-4 w-4 opacity-75" />
      <span class="font-medium text-md-on-surface">!?猪猪?!</span>
    </div>
    <nav class="flex items-center gap-4 text-xs font-medium">
      <a
        href="https://github.com/Fztbu-CS/CSA48"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md-full px-3 py-1.5 transition-colors hover:bg-md-on-surface/8 text-md-primary hover:text-md-primary font-semibold"
      >
        GitHub 仓库
      </a>
    </nav>
  </div>
</footer>
