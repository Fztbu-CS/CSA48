---
import type { PersonStats, ShameIncident } from '../data/types';
import Icon from './Icon.astro';
import { resolveAvatar } from '../utils/avatar';

interface Props {
  rankedPersons: PersonStats[];
  incidents: ShameIncident[];
}

const { rankedPersons, incidents } = Astro.props;

const totalIncidents = incidents.length;
const totalPersons = rankedPersons.length;
const avgPerPerson = totalPersons > 0 ? (totalIncidents / totalPersons).toFixed(1) : '0';
const topPerson = rankedPersons[0];
const maxCount = topPerson ? Math.max(topPerson.totalCount, 1) : 1;

// 最新录入事件（前 5 条）
const sortedIncidents = [...incidents].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const recentIncidents = sortedIncidents.slice(0, 5);
const personMap = new Map(rankedPersons.map((p) => [p.id, p]));
---

<div class="space-y-6">
  <!-- 关键指标 -->
  <div class="stats stats-vertical border border-base-300 shadow-md lg:stats-horizontal">
    <div class="stat">
      <div class="stat-title flex items-center gap-1.5 text-primary">
        <Icon name="chart" class="w-3.5 h-3.5" />
        <span>累计次数</span>
      </div>
      <div class="stat-value">
        {totalIncidents} <span class="text-xs font-normal text-base-content/60">次</span>
      </div>
      <div class="stat-desc">由团队持续登记收录</div>
    </div>

    <div class="stat">
      <div class="stat-title flex items-center gap-1.5 text-secondary">
        <Icon name="crown" class="w-3.5 h-3.5" />
        <span>榜一霸主</span>
      </div>
      <div class="stat-value truncate text-xl sm:text-2xl">
        {topPerson ? topPerson.name : '暂无'}
      </div>
      <div class="stat-desc truncate">累计 {topPerson?.totalCount || 0} 次</div>
    </div>

    <div class="stat">
      <div class="stat-title flex items-center gap-1.5 text-secondary">
        <Icon name="medal" class="w-3.5 h-3.5" />
        <span>上榜猪猪</span>
      </div>
      <div class="stat-value">
        {totalPersons} <span class="text-xs font-normal text-base-content/60">只</span>
      </div>
      <div class="stat-desc">榜上有名共勉前行</div>
    </div>

    <div class="stat">
      <div class="stat-title flex items-center gap-1.5 text-primary">
        <Icon name="pig" class="w-3.5 h-3.5" />
        <span>人均犯蠢次数</span>
      </div>
      <div class="stat-value">
        {avgPerPerson} <span class="text-xs font-normal text-base-content/60">次/人</span>
      </div>
      <div class="stat-desc">全员共同平摊的喜悦</div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- 次数分布 -->
    <div class="card card-bordered bg-base-200 shadow-md">
      <div class="card-body">
        <h3 class="card-title text-base">
          <Icon name="chart" class="w-4 h-4" />
          <span>成员犯蠢次数分布</span>
        </h3>

        <div class="space-y-3.5">
          {rankedPersons.length === 0 ? (
            <div class="py-8 text-center text-xs text-base-content/60">暂无猪猪数据</div>
          ) : (
            rankedPersons.map((p) => {
              const avatar = resolveAvatar(p.avatar, p.name);
              const percentage = Math.round((p.totalCount / maxCount) * 100);

              return (
                <div>
                  <div class="mb-1.5 flex items-center justify-between text-xs">
                    <span class="flex items-center gap-2 font-medium">
                      <div class="avatar placeholder">
                        <div class="w-5 rounded bg-neutral text-neutral-content text-[10px] font-bold">
                          {avatar.src ? (
                            <img
                              src={avatar.src}
                              alt={p.name}
                              onerror={`this.parentElement.textContent='${avatar.fallback}'`}
                            />
                          ) : (
                            <span>{avatar.fallback}</span>
                          )}
                        </div>
                      </div>
                      <span>{p.name}</span>
                    </span>
                    <span class="font-mono font-bold text-base-content/60">{p.totalCount} 次</span>
                  </div>
                  <progress class="progress progress-secondary h-2" value={percentage} max="100"></progress>
                </div>
              );
            })
          )}
        </div>
      </div>
    </div>

    <!-- 最新事件简报 -->
    <div class="card card-bordered bg-base-200 shadow-md">
      <div class="card-body justify-between">
        <div>
          <h3 class="card-title text-base">
            <Icon name="timeline" class="w-4 h-4" />
            <span>最新录入事件简报</span>
          </h3>

          <div class="mt-2 space-y-3">
            {recentIncidents.length === 0 ? (
              <div class="py-8 text-center text-xs text-base-content/60">暂无翻车事件记录</div>
            ) : (
              recentIncidents.map((inc) => {
                const p = personMap.get(inc.personId);
                return (
                  <div class="flex items-start justify-between gap-3 rounded-box border border-base-300 bg-base-100 p-3">
                    <div class="min-w-0">
                      <div class="mb-1 flex items-center gap-2">
                        {p && <span class="text-xs font-bold">{p.name}</span>}
                        <span class="font-mono text-[11px] text-base-content/60">{inc.date}</span>
                      </div>
                      <div class="truncate text-xs font-medium">{inc.title}</div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>

        <div class="mt-6 flex items-center justify-center gap-1.5 border-t border-base-300 pt-4 text-xs text-base-content/60">
          <Icon name="info" class="w-3.5 h-3.5" />
          <span>纯按实际犯蠢次数统计，公平公正</span>
        </div>
      </div>
    </div>
  </div>
</div>