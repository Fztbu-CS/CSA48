---
interface Props {
  avatar?: string;
  name: string;
  sizeClass?: string;
  class?: string;
}

const {
  avatar = '',
  name,
  sizeClass = 'w-10 h-10 text-sm',
  class: className = '',
} = Astro.props;

function isImageSrc(src?: string): boolean {
  if (!src) return false;
  const s = src.trim().toLowerCase();
  return (
    s.startsWith('http://') ||
    s.startsWith('https://') ||
    s.startsWith('data:image/') ||
    s.startsWith('/') ||
    s.endsWith('.png') ||
    s.endsWith('.jpg') ||
    s.endsWith('.jpeg') ||
    s.endsWith('.webp') ||
    s.endsWith('.gif') ||
    s.endsWith('.svg')
  );
}

const isImage = isImageSrc(avatar);

const baseUrl = import.meta.env.BASE_URL || '/';
function resolveSrc(src: string): string {
  if (src.startsWith('http://') || src.startsWith('https://') || src.startsWith('data:')) {
    return src;
  }
  const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  const cleanPath = src.startsWith('/') ? src : `/${src}`;
  return `${cleanBase}${cleanPath}`;
}

const resolvedSrc = isImage ? resolveSrc(avatar) : '';
const fallbackChar = !isImage && avatar && avatar.length <= 4 ? avatar : name ? name.slice(0, 1) : '?';
---

<div
  class={`avatar-box relative rounded-md-xl overflow-hidden shrink-0 flex items-center justify-center font-bold select-none bg-md-surface-container-highest text-md-on-surface border border-md-outline-variant/30 ${sizeClass} ${className}`}
>
  {isImage ? (
    <>
      <img
        src={resolvedSrc}
        alt={name}
        class="w-full h-full object-cover"
        loading="lazy"
        onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');"
      />
      <span class="hidden flex items-center justify-center w-full h-full text-center">
        {fallbackChar}
      </span>
    </>
  ) : (
    <span class="text-center">{fallbackChar}</span>
  )}
</div>
