---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import CrownedPig from './CrownedPig.astro';

interface Props {
  top3: PersonStats[];
}

const { top3 } = Astro.props;
const first = top3[0];
const second = top3[1];
const third = top3[2];
---

<section class="py-6 px-2 sm:px-4">
  <!-- Title / Section Header (MD3 Headline) -->
  <div class="text-center max-w-xl mx-auto mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md-full bg-md-secondary-container text-md-on-secondary-container text-xs font-medium mb-3">
      <Icon name="crown" class="w-3.5 h-3.5" />
      <span>猪颁奖.......</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-md-on-surface tracking-tight">
      谁是最强猪猪?!
    </h2>
    <p class="text-md-on-surface-variant text-xs sm:text-sm mt-1.5">
      
    </p>
  </div>

  <!-- MD3 Podium 3-Column Grid or Empty State -->
  {first ? (
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      
      <!-- Rank 2: Silver (Left) -->
      {second && (
        <div class="order-2 md:order-1 relative overflow-hidden flex flex-col justify-between p-6 rounded-md-2xl bg-md-surface-container-low border border-md-outline-variant/30 shadow-md-1 hover:shadow-md-2 transition-all group">
          <div class="relative z-10">
            <!-- Header: Rank badge with Crowned Piglet Mascot -->
            <div class="flex items-center justify-between mb-4">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md-full bg-slate-700/60 text-slate-200 text-xs font-bold border border-slate-600/50 shadow-sm">
                <span>大猪</span>
                <CrownedPig rank={2} class="w-5 h-5 shrink-0" />
              </div>
              <div class="w-8 h-8 rounded-md-full bg-slate-700/40 flex items-center justify-center text-slate-300">
                <Icon name="medal" class="w-4 h-4" />
              </div>
            </div>

            <!-- Avatar & Person Info (With Crowned Piglet behind the avatar) -->
            <div class="text-center mb-5 relative">
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-44 h-44 sm:w-48 sm:h-48 opacity-30 dark:opacity-35 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105">
                <CrownedPig rank={2} class="w-full h-full" />
              </div>
              <Avatar
                avatar={second.avatar}
                name={second.name}
                sizeClass="w-20 h-20 text-2xl"
                class="mx-auto mb-3 shadow-inner bg-slate-800 border-2 border-slate-400/50 text-slate-200 relative z-10"
              />
              <h3 class="text-lg font-bold text-md-on-surface relative z-10">{second.name}</h3>
            </div>

            <!-- Blunder Count Tonal Badge -->
            <div class="rounded-md-xl bg-md-surface-container p-3 mb-5 flex items-center justify-between border border-md-outline-variant/20">
              <span class="text-xs text-md-on-surface-variant">累计</span>
              <div class="text-xl font-bold text-md-on-surface">
                {second.totalCount} <span class="text-xs font-normal text-md-on-surface-variant">次</span>
              </div>
            </div>
          </div>

          <!-- Action Button -->
          <button
            class="view-person-btn md-state-layer w-full py-2.5 px-4 rounded-md-full bg-md-surface-container-highest hover:bg-md-surface-bright text-xs font-medium text-md-on-surface transition-colors flex items-center justify-center gap-1.5 relative z-10"
            data-person-id={second.id}
          >
            <Icon name="file-text" class="w-3.5 h-3.5 text-md-on-surface-variant" />
            <span>查看卷宗档案 ({second.totalCount})</span>
          </button>
        </div>
      )}

      <!-- Rank 1: Gold (Center - Elevated & Highlighted) -->
      {first && (
        <div class="order-1 md:order-2 relative flex flex-col justify-between p-6 sm:p-7 rounded-md-2xl bg-md-surface-container-high border-2 border-md-secondary/50 shadow-md-2 -mt-0 md:-mt-3 group">
          <!-- Crown badge decoration -->
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 rounded-md-full bg-md-secondary text-md-on-secondary text-xs font-bold shadow-md-1 flex items-center gap-1.5 z-20 whitespace-nowrap">
            <Icon name="crown" class="w-3.5 h-3.5" />
            <span>至尊猪猪</span>
          </div>

          <div class="relative z-10">
            <!-- Header -->
            <div class="flex items-center justify-between mb-4 mt-2">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md-full bg-md-secondary-container text-md-on-secondary-container text-xs font-bold shadow-sm">
                <span>!?猪猪?!</span>
                <CrownedPig rank={1} class="w-6 h-6 shrink-0" />
              </div>
              <div class="w-8 h-8 rounded-md-full bg-md-secondary/20 flex items-center justify-center text-md-secondary">
                <Icon name="trophy" class="w-4 h-4" />
              </div>
            </div>

            <!-- Avatar & Person Info (With Crowned Piglet behind the avatar) -->
            <div class="text-center mb-5 relative">
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-48 h-48 sm:w-52 sm:h-52 opacity-35 dark:opacity-40 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105">
                <CrownedPig rank={1} class="w-full h-full" />
              </div>
              <Avatar
                avatar={first.avatar}
                name={first.name}
                sizeClass="w-24 h-24 text-3xl"
                class="mx-auto mb-3 shadow-md-1 border-2 border-md-secondary bg-md-secondary-container text-md-on-secondary-container relative z-10"
              />
              <h3 class="text-xl font-extrabold text-md-secondary relative z-10">{first.name}</h3>
            </div>

            <!-- Blunder Count Tonal Badge (Highlighted) -->
            <div class="rounded-md-xl bg-md-secondary-container/40 p-3.5 mb-5 flex items-center justify-between border border-md-secondary/30">
              <span class="text-xs font-medium text-md-on-secondary-container">累计</span>
              <div class="text-2xl font-black text-md-secondary">
                {first.totalCount} <span class="text-xs font-normal text-md-on-surface-variant">次</span>
              </div>
            </div>
          </div>

          <!-- Action Button (MD3 Filled Secondary Button) -->
          <button
            class="view-person-btn md-state-layer w-full py-3 px-4 rounded-md-full bg-md-secondary text-md-on-secondary text-xs font-bold shadow-md-1 hover:shadow-md-2 transition-all flex items-center justify-center gap-1.5 active:scale-[0.98] relative z-10"
            data-person-id={first.id}
          >
            <Icon name="trophy" class="w-4 h-4" />
            <span>查看至尊案底 ({first.totalCount})</span>
          </button>
        </div>
      )}

      <!-- Rank 3: Bronze (Right) -->
      {third && (
        <div class="order-3 md:order-3 relative overflow-hidden flex flex-col justify-between p-6 rounded-md-2xl bg-md-surface-container-low border border-md-outline-variant/30 shadow-md-1 hover:shadow-md-2 transition-all group">
          <div class="relative z-10">
            <!-- Header -->
            <div class="flex items-center justify-between mb-4">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md-full bg-amber-900/60 text-amber-200 text-xs font-bold border border-amber-700/50 shadow-sm">
                <span>小猪</span>
                <CrownedPig rank={3} class="w-5 h-5 shrink-0" />
              </div>
              <div class="w-8 h-8 rounded-md-full bg-amber-900/40 flex items-center justify-center text-amber-400">
                <Icon name="medal" class="w-4 h-4" />
              </div>
            </div>

            <!-- Avatar & Person Info (With Crowned Piglet behind the avatar) -->
            <div class="text-center mb-5 relative">
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-44 h-44 sm:w-48 sm:h-48 opacity-30 dark:opacity-35 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105">
                <CrownedPig rank={3} class="w-full h-full" />
              </div>
              <Avatar
                avatar={third.avatar}
                name={third.name}
                sizeClass="w-20 h-20 text-2xl"
                class="mx-auto mb-3 shadow-inner bg-amber-950/40 border-2 border-amber-600/50 text-amber-200 relative z-10"
              />
              <h3 class="text-lg font-bold text-md-on-surface relative z-10">{third.name}</h3>
            </div>

            <!-- Blunder Count Tonal Badge -->
            <div class="rounded-md-xl bg-md-surface-container p-3 mb-5 flex items-center justify-between border border-md-outline-variant/20">
              <span class="text-xs text-md-on-surface-variant">累计</span>
              <div class="text-xl font-bold text-md-on-surface">
                {third.totalCount} <span class="text-xs font-normal text-md-on-surface-variant">次</span>
              </div>
            </div>
          </div>

          <!-- Action Button -->
          <button
            class="view-person-btn md-state-layer w-full py-2.5 px-4 rounded-md-full bg-md-surface-container-highest hover:bg-md-surface-bright text-xs font-medium text-md-on-surface transition-colors flex items-center justify-center gap-1.5 relative z-10"
            data-person-id={third.id}
          >
            <Icon name="file-text" class="w-3.5 h-3.5 text-md-on-surface-variant" />
            <span>查看卷宗档案 ({third.totalCount})</span>
          </button>
        </div>
      )}

    </div>
  ) : (
    <div class="max-w-md mx-auto text-center p-8 sm:p-10 rounded-md-2xl bg-md-surface-container-low border border-md-outline-variant/30 shadow-md-1">
      <div class="w-16 h-16 mx-auto mb-3.5 rounded-full bg-md-surface-container-highest flex items-center justify-center text-md-on-surface-variant/40">
        <Icon name="crown" class="w-8 h-8" />
      </div>
      <h3 class="text-base font-bold text-md-on-surface mb-1">暂无猪猪登榜</h3>
      <p class="text-xs text-md-on-surface-variant leading-relaxed">
        领奖台虚位以待，快去管理后台录入第一起翻车记录吧~
      </p>
    </div>
  )}
</section>
