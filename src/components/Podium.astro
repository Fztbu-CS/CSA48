---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import PodiumCard from './podium/PodiumCard.astro';
import EmptyState from './ui/EmptyState.astro';

interface Props {
  top3: PersonStats[];
}

const { top3 } = Astro.props;
const [first, second, third] = top3;
---

<section class="py-6 sm:py-8 px-2 sm:px-4">
  <!-- Title & Chip -->
  <div class="text-center max-w-xl mx-auto mb-8 sm:mb-10">
    <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-md-full bg-md-tertiary-container text-md-on-tertiary-container text-xs font-semibold shadow-sm mb-3">
      <Icon name="crown" class="w-3.5 h-3.5" />
      <span>猪猪金榜 · 领奖台</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-md-on-surface">
      谁是最强猪猪?!
    </h2>
  </div>

  {first ? (
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      {second && <PodiumCard person={second} rank={2} />}
      {first && <PodiumCard person={first} rank={1} />}
      {third && <PodiumCard person={third} rank={3} />}
    </div>
  ) : (
    <EmptyState
      icon="crown"
      title="暂无猪猪登榜"
      description="领奖台虚位以待，快去管理后台录入第一起翻车记录吧~"
      class="max-w-md mx-auto p-8 sm:p-10"
    />
  )}
</section>