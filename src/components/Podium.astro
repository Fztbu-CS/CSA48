---
import type { PersonStats } from '../data/types';
import Icon from './Icon.astro';
import CrownedPig from './CrownedPig.astro';
import { resolveAvatar } from '../utils/avatar';

interface Props {
  top3: PersonStats[];
}

const { top3 } = Astro.props;
const first = top3[0];
const second = top3[1];
const third = top3[2];

const firstAvatar = first ? resolveAvatar(first.avatar, first.name) : null;
const secondAvatar = second ? resolveAvatar(second.avatar, second.name) : null;
const thirdAvatar = third ? resolveAvatar(third.avatar, third.name) : null;
---

<section class="py-8 px-2 sm:px-4">
  <!-- 标题 -->
  <div class="text-center max-w-xl mx-auto mb-10">
    <div class="badge badge-secondary gap-1.5 mb-3">
      <Icon name="crown" class="w-3.5 h-3.5" />
      <span>猪颁奖.......</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
      谁是最强猪猪?!
    </h2>
  </div>

  {first ? (
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      <!-- 第二名：银牌 -->
      {second && (
        <div class="card card-bordered group order-2 md:order-1 bg-base-200 shadow-md transition-shadow hover:shadow-lg">
          <div class="card-body gap-4">
            <div class="flex items-center justify-between">
              <span class="badge badge-neutral gap-2">
                <span>大猪</span>
                <CrownedPig rank={2} class="w-5 h-5 shrink-0" />
              </span>
              <Icon name="medal" class="w-5 h-5 text-base-content/50" />
            </div>

            <div class="relative text-center">
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-44 h-44 sm:w-48 sm:h-48 opacity-30 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105">
                <CrownedPig rank={2} class="w-full h-full" />
              </div>
              <div class="relative z-10">
                <div class="avatar placeholder mx-auto mb-3">
                  <div class="w-20 rounded-full border-2 border-neutral bg-neutral text-neutral-content text-2xl font-bold">
                    {secondAvatar?.src ? (
                      <img
                        src={secondAvatar.src}
                        alt={second.name}
                        onerror={`this.parentElement.textContent='${secondAvatar.fallback}'`}
                      />
                    ) : (
                      <span>{secondAvatar?.fallback}</span>
                    )}
                  </div>
                </div>
                <h3 class="text-lg font-bold">{second.name}</h3>
              </div>
            </div>

            <div class="flex items-center justify-between rounded-box bg-base-100 p-3">
              <span class="text-xs text-base-content/60">累计</span>
              <span class="text-xl font-bold">
                {second.totalCount} <span class="text-xs font-normal text-base-content/60">次</span>
              </span>
            </div>

            <div class="card-actions mt-auto">
              <button class="view-person-btn btn btn-block btn-sm gap-1.5" data-person-id={second.id}>
                <Icon name="file-text" class="w-3.5 h-3.5" />
                <span>查看卷宗档案 ({second.totalCount})</span>
              </button>
            </div>
          </div>
        </div>
      )}

      <!-- 第一名：金牌 -->
      {first && (
        <div class="card card-bordered group order-1 md:order-2 relative border-warning bg-base-100 shadow-xl md:-mt-3">
          <span class="badge badge-warning absolute -top-3.5 left-1/2 -translate-x-1/2 z-20 gap-1.5 whitespace-nowrap font-bold shadow-md">
            <Icon name="crown" class="w-3.5 h-3.5" />
            <span>至尊猪猪</span>
          </span>

          <div class="card-body gap-4 pt-8">
            <div class="flex items-center justify-between">
              <span class="badge badge-warning gap-2 font-bold">
                <span>!?猪猪?!</span>
                <CrownedPig rank={1} class="w-6 h-6 shrink-0" />
              </span>
              <Icon name="trophy" class="w-5 h-5 text-warning" />
            </div>

            <div class="relative text-center">
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-48 h-48 sm:w-52 sm:h-52 opacity-35 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105">
                <CrownedPig rank={1} class="w-full h-full" />
              </div>
              <div class="relative z-10">
                <div class="avatar placeholder mx-auto mb-3">
                  <div class="w-24 rounded-full border-2 border-warning bg-warning text-warning-content text-3xl font-bold">
                    {firstAvatar?.src ? (
                      <img
                        src={firstAvatar.src}
                        alt={first.name}
                        onerror={`this.parentElement.textContent='${firstAvatar.fallback}'`}
                      />
                    ) : (
                      <span>{firstAvatar?.fallback}</span>
                    )}
                  </div>
                </div>
                <h3 class="text-xl font-extrabold">{first.name}</h3>
              </div>
            </div>

            <div class="flex items-center justify-between rounded-box bg-base-200 p-3.5">
              <span class="text-xs font-medium">累计</span>
              <span class="text-2xl font-black text-primary">
                {first.totalCount} <span class="text-xs font-normal text-base-content/60">次</span>
              </span>
            </div>

            <div class="card-actions mt-auto">
              <button
                class="view-person-btn btn btn-primary btn-block gap-1.5 font-bold"
                data-person-id={first.id}
              >
                <Icon name="trophy" class="w-4 h-4" />
                <span>查看至尊案底 ({first.totalCount})</span>
              </button>
            </div>
          </div>
        </div>
      )}

      <!-- 第三名：铜牌 -->
      {third && (
        <div class="card card-bordered group order-3 md:order-3 bg-base-200 shadow-md transition-shadow hover:shadow-lg">
          <div class="card-body gap-4">
            <div class="flex items-center justify-between">
              <span class="badge badge-accent gap-2">
                <span>小猪</span>
                <CrownedPig rank={3} class="w-5 h-5 shrink-0" />
              </span>
              <Icon name="medal" class="w-5 h-5 text-base-content/50" />
            </div>

            <div class="relative text-center">
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-44 h-44 sm:w-48 sm:h-48 opacity-30 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105">
                <CrownedPig rank={3} class="w-full h-full" />
              </div>
              <div class="relative z-10">
                <div class="avatar placeholder mx-auto mb-3">
                  <div class="w-20 rounded-full border-2 border-accent bg-accent text-accent-content text-2xl font-bold">
                    {thirdAvatar?.src ? (
                      <img
                        src={thirdAvatar.src}
                        alt={third.name}
                        onerror={`this.parentElement.textContent='${thirdAvatar.fallback}'`}
                      />
                    ) : (
                      <span>{thirdAvatar?.fallback}</span>
                    )}
                  </div>
                </div>
                <h3 class="text-lg font-bold">{third.name}</h3>
              </div>
            </div>

            <div class="flex items-center justify-between rounded-box bg-base-100 p-3">
              <span class="text-xs text-base-content/60">累计</span>
              <span class="text-xl font-bold">
                {third.totalCount} <span class="text-xs font-normal text-base-content/60">次</span>
              </span>
            </div>

            <div class="card-actions mt-auto">
              <button class="view-person-btn btn btn-block btn-sm gap-1.5" data-person-id={third.id}>
                <Icon name="file-text" class="w-3.5 h-3.5" />
                <span>查看卷宗档案 ({third.totalCount})</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="card card-bordered max-w-md mx-auto bg-base-200 shadow-md">
      <div class="card-body items-center text-center">
        <Icon name="crown" class="w-10 h-10 text-base-content/30" />
        <h3 class="card-title text-base">暂无猪猪登榜</h3>
        <p class="text-xs text-base-content/60 leading-relaxed">
          领奖台虚位以待，快去管理后台录入第一起翻车记录吧~
        </p>
      </div>
    </div>
  )}
</section>