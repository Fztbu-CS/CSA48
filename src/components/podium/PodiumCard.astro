---
import type { PersonStats } from '../../data/types';
import Icon from '../Icon.astro';
import CrownedPig from '../CrownedPig.astro';
import Avatar from '../ui/Avatar.astro';

interface Props {
  person: PersonStats;
  rank: 1 | 2 | 3;
}

const { person, rank } = Astro.props;

const config = {
  1: {
    containerClass:
      'order-1 md:order-2 rounded-md-3xl bg-md-surface-container-high border-2 border-amber-400/80 dark:border-amber-500/70 shadow-md-2 hover:shadow-md-3 p-6 sm:p-7 relative md:-mt-3 flex flex-col justify-between group transition-all',
    tagClass:
      'bg-amber-500/20 text-amber-800 dark:text-amber-200 text-xs font-black border border-amber-500/30 shadow-sm px-3.5 py-1.5',
    tagLabel: '!?猪猪霸主?!',
    pigSizeClass: 'w-48 h-48 sm:w-52 sm:h-52 opacity-35 dark:opacity-40',
    avatarClass:
      'border-2 border-amber-400 bg-amber-100 dark:bg-amber-950/80 text-3xl font-black text-amber-950 dark:text-amber-200 shadow-md-1 h-24 w-24 mx-auto mb-3',
    nameClass: 'text-xl font-black text-md-on-surface',
    metricBoxClass: 'rounded-md-2xl bg-amber-500/10 border border-amber-500/25 p-3.5 mb-5',
    metricLabelClass: 'text-xs font-medium text-amber-800 dark:text-amber-200',
    metricCountClass: 'text-2xl font-black text-amber-600 dark:text-amber-400',
    btnClass:
      'w-full py-3 px-4 rounded-md-full bg-amber-400 hover:bg-amber-500 dark:bg-amber-500 dark:hover:bg-amber-400 text-amber-950 text-xs font-black shadow-md-1 hover:shadow-md-2 transition-all flex items-center justify-center gap-1.5 active:scale-[0.98] relative z-10',
    btnIcon: 'trophy' as const,
    btnLabel: `查看至尊案底 (${person.totalCount})`,
  },
  2: {
    containerClass:
      'order-2 md:order-1 rounded-md-3xl bg-md-surface-container border border-md-outline-variant/30 shadow-md-1 hover:shadow-md-2 p-5 sm:p-6 flex flex-col justify-between transition-all group',
    tagClass:
      'bg-slate-200 dark:bg-slate-700/80 text-slate-800 dark:text-slate-200 text-xs font-bold shadow-sm px-3 py-1',
    tagLabel: '大猪',
    pigSizeClass: 'w-44 h-44 sm:w-48 sm:h-48 opacity-30 dark:opacity-35',
    avatarClass:
      'border-2 border-slate-300 dark:border-slate-600 bg-slate-100 dark:bg-slate-800 text-2xl font-bold text-slate-800 dark:text-slate-200 shadow-inner h-20 w-20 mx-auto mb-3',
    nameClass: 'text-lg font-bold text-md-on-surface',
    metricBoxClass: 'rounded-md-2xl bg-md-surface-container-high border border-md-outline-variant/20 p-3 mb-5',
    metricLabelClass: 'text-xs text-md-on-surface-variant',
    metricCountClass: 'text-xl font-bold text-md-on-surface',
    btnClass:
      'w-full py-2.5 px-4 rounded-md-full bg-md-surface-container-highest hover:bg-md-surface-bright text-xs font-medium text-md-on-surface transition-colors flex items-center justify-center gap-1.5 relative z-10',
    btnIcon: 'file-text' as const,
    btnLabel: `查看卷宗档案 (${person.totalCount})`,
  },
  3: {
    containerClass:
      'order-3 md:order-3 rounded-md-3xl bg-md-surface-container border border-md-outline-variant/30 shadow-md-1 hover:shadow-md-2 p-5 sm:p-6 flex flex-col justify-between transition-all group',
    tagClass:
      'bg-amber-900/15 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 text-xs font-bold border border-amber-700/30 shadow-sm px-3 py-1',
    tagLabel: '小猪',
    pigSizeClass: 'w-44 h-44 sm:w-48 sm:h-48 opacity-30 dark:opacity-35',
    avatarClass:
      'border-2 border-amber-600/40 bg-amber-50 dark:bg-amber-950/40 text-2xl font-bold text-amber-900 dark:text-amber-200 shadow-inner h-20 w-20 mx-auto mb-3',
    nameClass: 'text-lg font-bold text-md-on-surface',
    metricBoxClass: 'rounded-md-2xl bg-md-surface-container-high border border-md-outline-variant/20 p-3 mb-5',
    metricLabelClass: 'text-xs text-md-on-surface-variant',
    metricCountClass: 'text-xl font-bold text-md-on-surface',
    btnClass:
      'w-full py-2.5 px-4 rounded-md-full bg-md-surface-container-highest hover:bg-md-surface-bright text-xs font-medium text-md-on-surface transition-colors flex items-center justify-center gap-1.5 relative z-10',
    btnIcon: 'file-text' as const,
    btnLabel: `查看卷宗档案 (${person.totalCount})`,
  },
}[rank];
---

<div class={config.containerClass}>
  {rank === 1 && (
    <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-md-full bg-amber-400 dark:bg-amber-500 text-amber-950 font-black text-xs shadow-md-1 flex items-center gap-1.5 z-20 whitespace-nowrap">
      <Icon name="crown" class="w-3.5 h-3.5" />
      <span>至尊猪猪</span>
    </span>
  )}

  <div>
    <div class:list={['flex items-center justify-between mb-4', rank === 1 ? 'mt-2' : '']}>
      <span class:list={['inline-flex items-center gap-1.5 rounded-md-full', config.tagClass]}>
        <span>{config.tagLabel}</span>
        <CrownedPig rank={rank} class={rank === 1 ? 'w-5 h-5 shrink-0' : 'w-4 h-4 shrink-0'} />
      </span>
      {rank === 1 ? (
        <Icon name="trophy" class="w-5 h-5 text-amber-500" />
      ) : (
        <Icon name="medal" class="w-5 h-5 text-md-on-surface-variant/50" />
      )}
    </div>

    <div class="relative text-center mb-5">
      <div
        class:list={[
          'absolute top-2 left-1/2 -translate-x-1/2 pointer-events-none select-none transition-transform duration-300 group-hover:scale-105',
          config.pigSizeClass,
        ]}
      >
        <CrownedPig rank={rank} class="w-full h-full" />
      </div>

      <div class="relative z-10">
        <Avatar avatar={person.avatar} name={person.name} class={config.avatarClass} />
        <h3 class={config.nameClass}>{person.name}</h3>
      </div>
    </div>

    <div class:list={['flex items-center justify-between', config.metricBoxClass]}>
      <span class={config.metricLabelClass}>累计犯蠢</span>
      <span class={config.metricCountClass}>
        {person.totalCount} <span class="text-xs font-normal text-md-on-surface-variant">次</span>
      </span>
    </div>
  </div>

  <button
    class:list={['view-person-btn md-state-layer', config.btnClass]}
    data-person-id={person.id}
  >
    <Icon name={config.btnIcon} class={rank === 1 ? 'w-4 h-4' : 'w-3.5 h-3.5 text-md-on-surface-variant'} />
    <span>{config.btnLabel}</span>
  </button>
</div>
