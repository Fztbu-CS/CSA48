---
import type { PersonStats } from '../../data/types';
import Icon from '../Icon.astro';
import Avatar from '../ui/Avatar.astro';

interface Props {
  person: PersonStats;
}

const { person } = Astro.props;
const isFirst = person.rank === 1;

function rankBadgeClass(rank?: number): string {
  if (rank === 1) return 'bg-amber-400 text-amber-950 font-black shadow-sm';
  if (rank === 2) return 'bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold';
  if (rank === 3) return 'bg-amber-900/15 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 font-bold';
  return 'bg-md-surface-container-highest text-md-on-surface-variant font-medium';
}
---

<div
  class:list={[
    'person-card md-state-layer rounded-md-2xl border transition-all p-4 sm:p-5 shadow-sm hover:shadow-md-1',
    isFirst
      ? 'border-amber-400/60 dark:border-amber-500/50 bg-md-surface-container-high'
      : 'border-md-outline-variant/30 dark:border-transparent bg-md-surface-container-low hover:bg-md-surface-container',
  ]}
  data-name={person.name}
  data-nickname={person.nickname}
  data-count={person.totalCount}
  data-recent={person.recentDate}
  data-id={person.id}
>
  <div class="flex flex-col gap-3">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <!-- Rank / Avatar / Name -->
      <div class="flex items-center gap-3.5 min-w-0">
        <span
          class:list={[
            'flex h-8 min-w-[2rem] items-center justify-center rounded-md-full px-2.5 text-xs font-mono shrink-0',
            rankBadgeClass(person.rank),
          ]}
        >
          #{person.rank}
        </span>

        <Avatar avatar={person.avatar} name={person.name} size="md" />

        <div class="min-w-0">
          <h3 class="text-base font-bold text-md-on-surface truncate">{person.name}</h3>
          {person.nickname && (
            <p class="text-xs text-md-on-surface-variant truncate">@{person.nickname}</p>
          )}
        </div>
      </div>

      <!-- Count & Action Button -->
      <div
        class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-3 sm:gap-4 border-t sm:border-t-0 border-md-outline-variant/20 dark:border-transparent pt-3 sm:pt-0 shrink-0"
      >
        <div
          class="flex items-center gap-1.5 rounded-md-full border border-md-primary/20 dark:border-transparent bg-md-primary-container/40 px-3 py-1 text-xs font-medium text-md-on-surface"
        >
          <span class="text-md-on-surface-variant">累计</span>
          <span class="font-bold text-md-primary">{person.totalCount} 次</span>
        </div>

        <button
          class="view-person-btn md-state-layer flex items-center gap-1.5 rounded-md-full border border-md-outline/30 dark:border-transparent dark:bg-md-surface-container-high px-3.5 py-1.5 text-xs font-semibold text-md-primary hover:bg-md-primary/8 transition-colors"
          data-person-id={person.id}
        >
          <Icon name="file-text" class="h-3.5 w-3.5" />
          <span>案底卷宗</span>
        </button>
      </div>
    </div>

    <!-- Latest Incident -->
    {person.incidents[0] && (
      <div class="flex items-center justify-between gap-2 rounded-md-xl border border-md-outline-variant/20 dark:border-transparent bg-md-surface-container/60 p-2.5 text-xs text-md-on-surface-variant">
        <div class="flex items-center gap-2 truncate pr-2">
          <span class="font-medium text-md-primary shrink-0">最新案情:</span>
          <span class="truncate font-medium text-md-on-surface">{person.incidents[0].title}</span>
        </div>
        <span class="flex items-center gap-1 text-[11px] shrink-0 font-mono text-md-on-surface-variant/80">
          <Icon name="calendar" class="h-3 w-3" />
          <span>{person.incidents[0].date}</span>
        </span>
      </div>
    )}
  </div>
</div>
