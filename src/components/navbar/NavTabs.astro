---
import Icon from '../Icon.astro';
---

<nav class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center">
  <div
    id="view-tabs"
    class="grid grid-cols-2 items-center rounded-md-full border border-md-outline-variant/30 dark:border-transparent bg-md-surface-container-high p-1 shadow-sm"
  >
    <button
      type="button"
      class="nav-tab tab-active flex items-center justify-center gap-1 rounded-md-full px-2.5 py-1 text-xs font-semibold text-md-on-secondary-container transition-all sm:gap-1.5 sm:px-4 sm:py-1.5 sm:text-sm whitespace-nowrap"
      data-target="view-leaderboard"
    >
      <Icon name="trophy" class="h-3.5 w-3.5 shrink-0 sm:h-4 sm:w-4" />
      <span>猪排行</span>
    </button>
    <button
      type="button"
      class="nav-tab flex items-center justify-center gap-1 rounded-md-full px-2.5 py-1 text-xs font-medium text-md-on-surface-variant transition-all hover:bg-md-on-surface/5 hover:text-md-on-surface sm:gap-1.5 sm:px-4 sm:py-1.5 sm:text-sm whitespace-nowrap"
      data-target="view-timeline"
    >
      <Icon name="timeline" class="h-3.5 w-3.5 shrink-0 sm:h-4 sm:w-4" />
      <span>猪记录</span>
    </button>
  </div>
</nav>

<script>
  // 视图切换
  const tabs = document.querySelectorAll<HTMLButtonElement>('#view-tabs .nav-tab');
  const views = ['view-leaderboard', 'view-timeline'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetView = tab.getAttribute('data-target');
      if (!targetView) return;

      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle('tab-active', isActive);
        if (isActive) {
          item.classList.add('bg-md-secondary-container', 'text-md-on-secondary-container', 'font-semibold', 'shadow-sm');
          item.classList.remove('text-md-on-surface-variant', 'font-medium');
        } else {
          item.classList.remove('bg-md-secondary-container', 'text-md-on-secondary-container', 'font-semibold', 'shadow-sm');
          item.classList.add('text-md-on-surface-variant', 'font-medium');
        }
      });

      views.forEach((viewId) => {
        const el = document.getElementById(viewId);
        if (el) {
          el.classList.toggle('hidden', viewId !== targetView);
        }
      });
    });
  });

  // 初始化 Tab 状态样式
  const initialActive = document.querySelector<HTMLButtonElement>('#view-tabs .tab-active');
  if (initialActive) {
    initialActive.classList.add('bg-md-secondary-container', 'text-md-on-secondary-container', 'font-semibold', 'shadow-sm');
    initialActive.classList.remove('text-md-on-surface-variant', 'font-medium');
  }
</script>
