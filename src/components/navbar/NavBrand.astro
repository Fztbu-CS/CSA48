---
import Icon from '../Icon.astro';
---

<div class="z-10 flex shrink-0 items-center">
  <a
    href="."
    class="group flex items-center gap-2 rounded-md-full p-1 transition-colors hover:bg-md-on-surface/8 sm:gap-2.5 sm:p-1.5"
  >
    <div
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md-xl bg-md-primary-container text-md-on-primary-container shadow-md-1 transition-transform group-hover:scale-105 sm:h-10 sm:w-10"
    >
      <Icon name="pig" class="h-5 w-5 sm:h-6 sm:w-6" />
    </div>
    <div class="flex flex-col leading-tight">
      <span class="text-sm font-bold tracking-tight text-md-on-surface sm:text-lg">!?猪猪?!</span>
      <span class="hidden text-[11px] font-medium text-md-on-surface-variant sm:block">!?者者?! · 排行榜</span>
    </div>
  </a>
</div>
