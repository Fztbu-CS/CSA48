---
import type { Person } from '../data/types';
import Icon from './Icon.astro';

interface Props {
  persons: Person[];
}

const { persons } = Astro.props;
---

<dialog id="report-dialog" class="modal">
  <div class="modal-box max-w-xl">
    <!-- 头部 -->
    <div class="mb-6 flex items-center justify-between border-b border-base-300 pb-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-primary-content">
          <Icon name="alert" class="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-xl font-bold">翻车立案登记</h2>
          <p class="mt-0.5 text-xs text-base-content/60">
            不管是检举揭发还是自首坦白，请如实记录精彩瞬间
          </p>
        </div>
      </div>

      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost" aria-label="关闭">
          <Icon name="close" class="w-4 h-4" />
        </button>
      </form>
    </div>

    <form id="report-form" class="space-y-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <label class="form-control w-full">
          <div class="label">
            <span class="label-text flex items-center gap-1">
              <Icon name="person" class="w-3.5 h-3.5" />
              <span>犯罪嫌疑人</span>
              <span class="text-error">*</span>
            </span>
          </div>
          <select id="form-person" required class="select select-bordered">
            <option value="">-- 请选择猪猪 --</option>
            {persons.map((p) => (
              <option value={p.id}>{p.name} ({p.nickname})</option>
            ))}
          </select>
        </label>

        <label class="form-control w-full">
          <div class="label">
            <span class="label-text flex items-center gap-1">
              <Icon name="calendar" class="w-3.5 h-3.5" />
              <span>案发日期</span>
              <span class="text-error">*</span>
            </span>
          </div>
          <input type="date" id="form-date" required class="input input-bordered" />
        </label>
      </div>

      <label class="form-control w-full">
        <div class="label">
          <span class="label-text flex items-center gap-1">
            <Icon name="file-text" class="w-3.5 h-3.5" />
            <span>翻车事件标题</span>
            <span class="text-error">*</span>
          </span>
        </div>
        <input
          type="text"
          id="form-title"
          required
          placeholder="如：生产数据库 Update 忘记加 WHERE 条件"
          class="input input-bordered"
        />
      </label>

      <label class="form-control w-full">
        <div class="label">
          <span class="label-text flex items-center gap-1">
            <span>案发详情与经过</span>
            <span class="text-error">*</span>
          </span>
        </div>
        <textarea
          id="form-description"
          rows="4"
          required
          placeholder="详细描述当时的惨烈过程，时间、地点、目击者反应等..."
          class="textarea textarea-bordered leading-relaxed"
        ></textarea>
      </label>

      <div class="modal-action">
        <button type="button" id="btn-copy-json" class="btn btn-ghost gap-1.5">
          <Icon name="clipboard" class="w-3.5 h-3.5" />
          <span>复制 PR 数据</span>
        </button>
        <button type="submit" id="btn-submit-local" class="btn btn-primary gap-1.5">
          <Icon name="plus" class="w-3.5 h-3.5" />
          <span>本地即刻上榜</span>
        </button>
      </div>
    </form>

    <!-- 复制成功提示 -->
    <div id="copy-toast" class="toast toast-center hidden">
      <div class="alert alert-success">
        <Icon name="check" class="w-4 h-4" />
        <span>JSON 数据已复制到剪贴板！可直接粘贴至 GitHub PR 或 Issue</span>
      </div>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>关闭</button>
  </form>
</dialog>

<script>
  import confetti from 'canvas-confetti';

  const dialog = document.getElementById('report-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-report-btn');
  const form = document.getElementById('report-form') as HTMLFormElement | null;
  const copyBtn = document.getElementById('btn-copy-json');
  const copyToast = document.getElementById('copy-toast');
  const dateInput = document.getElementById('form-date') as HTMLInputElement | null;

  // 默认日期为今天
  if (dateInput) {
    dateInput.value = new Date().toISOString().split('T')[0];
  }

  openBtn?.addEventListener('click', () => {
    dialog?.showModal();
  });

  function getFormData() {
    const personId = (document.getElementById('form-person') as HTMLSelectElement).value;
    const date = (document.getElementById('form-date') as HTMLInputElement).value;
    const title = (document.getElementById('form-title') as HTMLInputElement).value;
    const description = (document.getElementById('form-description') as HTMLTextAreaElement).value;

    return {
      id: `inc-${Date.now().toString(36)}`,
      personId,
      title,
      description,
      date,
      severity: 1 as const,
      category: 'code' as const,
      witnesses: [],
      tags: []
    };
  }

  // 复制 JSON（用于提 PR）
  copyBtn?.addEventListener('click', () => {
    const data = getFormData();
    const jsonStr = JSON.stringify(data, null, 2);
    navigator.clipboard.writeText(jsonStr).then(() => {
      if (copyToast) {
        copyToast.classList.remove('hidden');
        setTimeout(() => {
          copyToast.classList.add('hidden');
        }, 3000);
      }
    });
  });

  // 本地提交并撒花
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const incident = getFormData();

    const localIncidentsStr = localStorage.getItem('custom_incidents') || '[]';
    const localIncidents = JSON.parse(localIncidentsStr);
    localIncidents.push(incident);
    localStorage.setItem('custom_incidents', JSON.stringify(localIncidents));

    confetti({
      particleCount: 100,
      spread: 70,
      origin: { y: 0.6 }
    });

    dialog?.close();

    setTimeout(() => {
      window.location.reload();
    }, 600);
  });
</script>