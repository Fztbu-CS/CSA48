---
interface Props {
  variant?: 'primary' | 'secondary' | 'surface' | 'gold' | 'silver' | 'bronze' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'surface',
  size = 'md',
  class: className = '',
} = Astro.props;

const variantClasses = {
  primary: 'bg-md-primary-container text-md-on-primary-container border-transparent',
  secondary: 'bg-md-secondary-container text-md-on-secondary-container border-transparent',
  surface: 'bg-md-surface-container-high text-md-on-surface-variant border-md-outline-variant/30 dark:border-transparent',
  gold: 'bg-amber-400 text-amber-950 font-black border-transparent shadow-xs',
  silver: 'bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold border-transparent',
  bronze: 'bg-amber-900/15 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 font-bold border-transparent',
  outline: 'bg-transparent text-md-on-surface-variant border-md-outline-variant/30 dark:border-transparent',
}[variant];

const sizeClasses = {
  sm: 'px-2 py-0.5 text-[11px]',
  md: 'px-2.5 py-1 text-xs',
}[size];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md-full border font-medium transition-colors',
    variantClasses,
    sizeClasses,
    className,
  ]}
>
  <slot />
</span>
