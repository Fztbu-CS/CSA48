---
import Icon from './Icon.astro';
---

<div class="navbar sticky top-0 z-40 min-h-16 gap-2 border-b border-base-300 bg-base-100/90 px-2 backdrop-blur-md sm:px-4">
  <!-- Brand -->
  <div class="navbar-start">
    <a href="." class="btn btn-ghost gap-2 px-1.5 sm:px-3">
      <Icon name="pig" class="w-8 h-8 shrink-0 sm:w-9 sm:h-9" />
      <span class="flex flex-col items-start leading-tight">
        <span class="text-sm font-bold sm:text-base">!?猪猪?!</span>
        <span class="hidden text-[11px] font-normal text-base-content/60 sm:block">!?者者?!</span>
      </span>
    </a>
  </div>

  <!-- 视图切换 Tabs -->
  <div class="navbar-center">
    <div id="view-tabs" class="tabs tabs-boxed bg-base-200">
      <button
        type="button"
        class="tab tab-active gap-1.5 text-xs sm:text-sm"
        data-target="view-leaderboard"
      >
        <Icon name="trophy" class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
        <span>猪排行</span>
      </button>
      <button type="button" class="tab gap-1.5 text-xs sm:text-sm" data-target="view-timeline">
        <Icon name="timeline" class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
        <span>猪记录</span>
      </button>
    </div>
  </div>

  <!-- 明暗主题切换 -->
  <div class="navbar-end">
    <button
      id="theme-toggle-btn"
      type="button"
      class="btn btn-ghost btn-circle"
      title="切换明暗主题"
      aria-label="切换明暗主题"
    >
      <span id="theme-icon-dark" class="hidden"><Icon name="sun" class="w-5 h-5" /></span>
      <span id="theme-icon-light"><Icon name="moon" class="w-5 h-5" /></span>
    </button>
  </div>
</div>

<script>
  // 视图切换
  const tabs = document.querySelectorAll<HTMLButtonElement>('#view-tabs .tab');
  const views = ['view-leaderboard', 'view-timeline'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetView = tab.getAttribute('data-target');
      if (!targetView) return;

      tabs.forEach((item) => item.classList.toggle('tab-active', item === tab));
      views.forEach((viewId) => {
        document.getElementById(viewId)?.classList.toggle('hidden', viewId !== targetView);
      });
    });
  });

  // 明暗主题切换（daisyUI data-theme）
  const themeToggle = document.getElementById('theme-toggle-btn');
  const darkIcon = document.getElementById('theme-icon-dark');
  const lightIcon = document.getElementById('theme-icon-light');

  function syncThemeIcons(theme: string) {
    darkIcon?.classList.toggle('hidden', theme !== 'dark');
    lightIcon?.classList.toggle('hidden', theme === 'dark');
  }

  syncThemeIcons(document.documentElement.getAttribute('data-theme') || 'light');

  themeToggle?.addEventListener('click', () => {
    const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    syncThemeIcons(theme);
  });
</script>