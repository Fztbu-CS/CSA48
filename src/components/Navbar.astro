---
import NavBrand from './navbar/NavBrand.astro';
import NavTabs from './navbar/NavTabs.astro';
import PaletteMenu from './navbar/PaletteMenu.astro';
import ThemeToggle from './navbar/ThemeToggle.astro';
---

<header class="sticky top-0 z-40 border-b border-md-outline-variant/20 dark:border-transparent bg-md-surface transition-colors duration-200">
  <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-3 sm:h-20 sm:gap-3 sm:px-6">
    <!-- Brand (Start) -->
    <NavBrand />

    <!-- M3 Segmented Buttons (Center) -->
    <NavTabs />

    <!-- Controls (End) -->
    <div class="z-10 flex shrink-0 items-center gap-1 sm:gap-2">
      <PaletteMenu />
      <ThemeToggle />
    </div>
  </div>
</header>