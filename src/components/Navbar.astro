---
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-40 border-b border-md-outline-variant/30 bg-md-surface/90 backdrop-blur-md transition-colors duration-200">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-3 sm:h-20 sm:px-6">
    <!-- Brand (Start) -->
    <div class="flex items-center gap-3">
      <a href="." class="group flex items-center gap-2.5 rounded-md-full p-1.5 transition-colors hover:bg-md-on-surface/8">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md-xl bg-md-primary-container text-md-on-primary-container shadow-md-1 transition-transform group-hover:scale-105">
          <Icon name="pig" class="h-6 w-6" />
        </div>
        <div class="flex flex-col leading-tight">
          <span class="text-base font-bold tracking-tight text-md-on-surface sm:text-lg">!?猪猪?!</span>
          <span class="hidden text-[11px] font-medium text-md-on-surface-variant sm:block">!?者者?! · 排行榜</span>
        </div>
      </a>
    </div>

    <!-- M3 Segmented Buttons (Center) -->
    <nav class="flex items-center">
      <div id="view-tabs" class="flex items-center rounded-md-full border border-md-outline-variant/30 bg-md-surface-container-high p-1 shadow-sm">
        <button
          type="button"
          class="nav-tab tab-active flex items-center gap-1.5 rounded-md-full px-3.5 py-1.5 text-xs font-semibold text-md-on-secondary-container transition-all sm:px-4 sm:text-sm"
          data-target="view-leaderboard"
        >
          <Icon name="trophy" class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
          <span>猪排行</span>
        </button>
        <button
          type="button"
          class="nav-tab flex items-center gap-1.5 rounded-md-full px-3.5 py-1.5 text-xs font-medium text-md-on-surface-variant transition-all hover:bg-md-on-surface/5 hover:text-md-on-surface sm:px-4 sm:text-sm"
          data-target="view-timeline"
        >
          <Icon name="timeline" class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
          <span>猪记录</span>
        </button>
      </div>
    </nav>

    <!-- Controls (End) -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Material You Dynamic Palette Menu -->
      <div class="relative">
        <button
          id="palette-toggle-btn"
          type="button"
          class="md-state-layer flex h-10 w-10 items-center justify-center rounded-md-full text-md-on-surface-variant transition-colors hover:bg-md-on-surface/8 hover:text-md-on-surface"
          title="Material You 色彩主题"
          aria-label="切换色彩主题"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
            <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
            <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
            <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
          </svg>
        </button>

        <!-- Palette Dropdown Popover -->
        <div
          id="palette-menu"
          class="absolute right-0 top-12 hidden w-48 rounded-md-2xl border border-md-outline-variant/30 bg-md-surface-container-high p-2 shadow-md-3 z-50 animate-in fade-in zoom-in-95 duration-150"
        >
          <div class="px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-wider text-md-on-surface-variant/80">
            Material You 色盘
          </div>
          <div class="flex flex-col gap-1">
            <button
              type="button"
              class="palette-option flex items-center gap-2.5 rounded-md-xl px-2.5 py-1.5 text-xs font-medium text-md-on-surface hover:bg-md-on-surface/8 transition-colors"
              data-palette-value="rose"
            >
              <span class="h-4 w-4 rounded-full bg-[#984061] border border-white/20"></span>
              <span>小猪粉 (默认)</span>
            </button>
            <button
              type="button"
              class="palette-option flex items-center gap-2.5 rounded-md-xl px-2.5 py-1.5 text-xs font-medium text-md-on-surface hover:bg-md-on-surface/8 transition-colors"
              data-palette-value="sakura"
            >
              <span class="h-4 w-4 rounded-full bg-[#8f4a5d] border border-white/20"></span>
              <span>樱花粉</span>
            </button>
            <button
              type="button"
              class="palette-option flex items-center gap-2.5 rounded-md-xl px-2.5 py-1.5 text-xs font-medium text-md-on-surface hover:bg-md-on-surface/8 transition-colors"
              data-palette-value="green"
            >
              <span class="h-4 w-4 rounded-full bg-[#3b6939] border border-white/20"></span>
              <span>鼠尾草绿</span>
            </button>
            <button
              type="button"
              class="palette-option flex items-center gap-2.5 rounded-md-xl px-2.5 py-1.5 text-xs font-medium text-md-on-surface hover:bg-md-on-surface/8 transition-colors"
              data-palette-value="blue"
            >
              <span class="h-4 w-4 rounded-full bg-[#1e5fa0] border border-white/20"></span>
              <span>海洋蓝</span>
            </button>
            <button
              type="button"
              class="palette-option flex items-center gap-2.5 rounded-md-xl px-2.5 py-1.5 text-xs font-medium text-md-on-surface hover:bg-md-on-surface/8 transition-colors"
              data-palette-value="amber"
            >
              <span class="h-4 w-4 rounded-full bg-[#815500] border border-white/20"></span>
              <span>夕阳琥珀</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Theme Switch (Dark/Light) -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="md-state-layer flex h-10 w-10 items-center justify-center rounded-md-full text-md-on-surface-variant transition-colors hover:bg-md-on-surface/8 hover:text-md-on-surface"
        title="切换明暗色彩模式"
        aria-label="切换明暗色彩模式"
      >
        <span id="theme-icon-dark" class="hidden"><Icon name="sun" class="h-5 w-5" /></span>
        <span id="theme-icon-light"><Icon name="moon" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  // 视图切换
  const tabs = document.querySelectorAll<HTMLButtonElement>('#view-tabs .nav-tab');
  const views = ['view-leaderboard', 'view-timeline'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetView = tab.getAttribute('data-target');
      if (!targetView) return;

      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle('tab-active', isActive);
        if (isActive) {
          item.classList.add('bg-md-secondary-container', 'text-md-on-secondary-container', 'font-semibold', 'shadow-sm');
          item.classList.remove('text-md-on-surface-variant', 'font-medium');
        } else {
          item.classList.remove('bg-md-secondary-container', 'text-md-on-secondary-container', 'font-semibold', 'shadow-sm');
          item.classList.add('text-md-on-surface-variant', 'font-medium');
        }
      });

      views.forEach((viewId) => {
        const el = document.getElementById(viewId);
        if (el) {
          el.classList.toggle('hidden', viewId !== targetView);
        }
      });
    });
  });

  // 初始化 Tab 状态样式
  const initialActive = document.querySelector<HTMLButtonElement>('#view-tabs .tab-active');
  if (initialActive) {
    initialActive.classList.add('bg-md-secondary-container', 'text-md-on-secondary-container', 'font-semibold', 'shadow-sm');
    initialActive.classList.remove('text-md-on-surface-variant', 'font-medium');
  }

  // 明暗主题切换
  const themeToggle = document.getElementById('theme-toggle-btn');
  const darkIcon = document.getElementById('theme-icon-dark');
  const lightIcon = document.getElementById('theme-icon-light');

  function syncThemeIcons(theme: string) {
    darkIcon?.classList.toggle('hidden', theme !== 'dark');
    lightIcon?.classList.toggle('hidden', theme === 'dark');
  }

  const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
  syncThemeIcons(currentTheme);

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const nextTheme = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    if (nextTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('theme', nextTheme);
    syncThemeIcons(nextTheme);
  });

  // Material You Dynamic Palette Switcher
  const paletteBtn = document.getElementById('palette-toggle-btn');
  const paletteMenu = document.getElementById('palette-menu');
  const paletteOptions = document.querySelectorAll<HTMLButtonElement>('.palette-option');

  paletteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    paletteMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!paletteMenu?.contains(e.target as Node) && e.target !== paletteBtn) {
      paletteMenu?.classList.add('hidden');
    }
  });

  paletteOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      const palette = btn.getAttribute('data-palette-value');
      if (palette) {
        document.documentElement.setAttribute('data-palette', palette);
        localStorage.setItem('palette', palette);
        paletteMenu?.classList.add('hidden');
      }
    });
  });
</script>