---
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-40 w-full bg-md-surface/90 backdrop-blur-md border-b border-md-outline-variant/40 transition-colors">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    <!-- Brand (Leading) -->
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0 z-10">
      <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center shrink-0">
        <Icon name="pig" class="w-8 h-8 sm:w-9 sm:h-9" />
      </div>
      <div class="hidden min-[380px]:block">
        <div class="flex items-center gap-1.5">
          <span class="text-sm sm:text-base font-bold text-md-on-surface tracking-normal">
            !?猪猪?!
          </span>
        </div>
        <p class="text-[11px] text-md-on-surface-variant hidden sm:block">!?者者?!</p>
      </div>
    </div>

    <!-- MD3 Segmented Button Navigation (Center) -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <nav class="pointer-events-auto flex items-center p-1 rounded-md-full bg-md-surface-container border border-md-outline-variant/50 text-xs sm:text-sm font-medium shadow-sm">
        <button
          id="tab-btn-podium"
          class="tab-btn md-state-layer px-3 sm:px-3.5 py-1.5 rounded-md-full transition-all text-md-on-secondary-container bg-md-secondary-container font-semibold flex items-center gap-1.5 sm:gap-2 shadow-sm"
          data-target="view-leaderboard"
        >
          <Icon name="trophy" class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
          <span>猪排行</span>
        </button>
        <button
          id="tab-btn-timeline"
          class="tab-btn md-state-layer px-3 sm:px-3.5 py-1.5 rounded-md-full transition-all text-md-on-surface-variant hover:text-md-on-surface flex items-center gap-1.5 sm:gap-2"
          data-target="view-timeline"
        >
          <Icon name="timeline" class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
          <span>猪记录</span>
        </button>
      </nav>
    </div>

    <!-- MD3 Actions (Trailing: Theme Toggle only, pure display) -->
    <div class="flex items-center shrink-0 z-10">
      <!-- Light / Dark Mode Toggle Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        title="切换明暗主题"
        aria-label="切换明暗主题"
        class="md-state-layer w-9 h-9 sm:w-10 sm:h-10 rounded-md-full bg-md-surface-container hover:bg-md-surface-container-high border border-md-outline-variant/40 flex items-center justify-center text-md-on-surface transition-colors shadow-sm"
      >
        <span class="hidden dark:block">
          <Icon name="sun" class="w-4 h-4 text-md-secondary" />
        </span>
        <span class="block dark:hidden">
          <Icon name="moon" class="w-4 h-4 text-md-primary" />
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  // Tab controller for MD3 Segmented Buttons
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const views = ['view-leaderboard', 'view-timeline'];

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetView = btn.getAttribute('data-target');
      if (!targetView) return;

      // Update button styles to MD3 active/inactive states
      tabButtons.forEach(b => {
        b.classList.remove('text-md-on-secondary-container', 'bg-md-secondary-container', 'font-semibold', 'shadow-sm');
        b.classList.add('text-md-on-surface-variant');
      });
      btn.classList.add('text-md-on-secondary-container', 'bg-md-secondary-container', 'font-semibold', 'shadow-sm');
      btn.classList.remove('text-md-on-surface-variant');

      // Update views
      views.forEach(viewId => {
        const el = document.getElementById(viewId);
        if (el) {
          if (viewId === targetView) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        }
      });
    });
  });

  // Light / Dark Theme Switcher
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
